# OneBook ELD web panel — environment (web/tz.md §2.3)
# The backend runs app.setGlobalPrefix('api') with unversioned controller paths:
# the real URL is /api/vehicles, never /api/v1/vehicles.
VITE_API_BASE_URL=http://localhost:3002/api
VITE_WS_URL=http://localhost:3002
VITE_WS_NAMESPACE=/realtime
VITE_MAP_STYLE_URL=
VITE_MAP_API_KEY=
# Trips Route Preview road routing (OSRM `route` API, no key). Empty = public demo server
# https://router.project-osrm.org (dev only; self-host for prod and add its host to $eld_map_hosts in the nginx CSP).
VITE_ROUTING_URL=
# Live Fleet `Traffic` layer — a traffic tile template with {z}/{x}/{y}. Empty = the Traffic chip is
# disabled. `.pbf`/`.mvt` = vector; anything else = raster (256px, or 512 with `tileSize=512` in the URL).
# HERE Traffic Raster v3 (primary; replace YOUR_KEY; tiles exist at zoom 8-20, "© HERE" is shown;
# add https://traffic.maps.hereapi.com to $eld_map_hosts in the nginx CSP):
#   https://traffic.maps.hereapi.com/v3/flow/mc/{z}/{x}/{y}/png?apiKey=YOUR_KEY
# TomTom alternative (add https://api.tomtom.com to $eld_map_hosts):
#   https://api.tomtom.com/traffic/map/4/tile/flow/relative0/{z}/{x}/{y}.pbf?key=YOUR_KEY
#   https://api.tomtom.com/traffic/map/4/tile/flow/relative0/{z}/{x}/{y}.png?tileSize=512&key=YOUR_KEY
VITE_TRAFFIC_TILES_URL=
# dev = Google + email/password · production = Google only (Q-1)
VITE_AUTH_MODE=dev
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_SENTRY_DSN=
VITE_APP_VERSION=dev
